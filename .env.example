# Optional development override: copy this file to .env.development.local.
# Vite does not load .env.example. Development defaults to /api/prices,
# proxied to http://localhost by vite.config.mts.
# Production builds load .env.production; CI can override it at build time.
# VITE_* values are public: never put credentials here.
VITE_PRICES_URL=/api/prices
